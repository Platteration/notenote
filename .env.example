# ---- Required in production ---------------------------------------------------
# Used to sign sessions and encrypt provider tokens at rest (>= 16 chars).
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of this app; OAuth redirect URIs are built from it.
APP_BASE_URL=http://localhost:3000
# Where the SQLite database lives (defaults to ./data).
# DATA_DIR=/var/lib/daily-scroll

# Pre-warm job: POST /api/cron/prewarm with "Authorization: Bearer $CRON_SECRET" every
# 15 minutes fetches fresh items for users whose hour opens within PREWARM_MINUTES.
# The same secret protects POST /api/cron/notify, which sends the daily "your hour is
# open" push. See the README for both crontab lines.
# CRON_SECRET=another-long-random-string
# PREWARM_MINUTES=30

# ---- Web Push -------------------------------------------------------------------
# Generate once with:  npx web-push generate-vapid-keys
# Without these, the notification switch in settings reports push as unavailable.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Bluesky is the one platform where the user picks the host the server connects to, so that
# host is checked against the network guard: private, loopback, link-local and reserved
# addresses are refused, on the first request and on every redirect it answers with. Set this
# only if you deliberately run a PDS on your own network.
# ALLOW_PRIVATE_PROVIDER_HOSTS=1

# ---- Behind a reverse proxy ------------------------------------------------------
# How many proxies in front of this app rewrite X-Forwarded-For. Nothing else identifies a
# client: there is no way to read the socket address from a route handler, so with the
# default of 0 the header is ignored entirely and the per-address rate limits do not run —
# sign-in still has an account-wide ceiling, and sign-up a deployment-wide one. Set this to
# the number of trusted hops (1 for a single nginx/Caddy in front) to get per-address limits.
# Do not set it unless the proxy really does append or rewrite the header, or clients can
# choose their own limit bucket.
# TRUSTED_PROXY_HOPS=1

# ---- Platform reliability -------------------------------------------------------
# A hung platform must never hold the first request of the hour open. Each call gets
# PROVIDER_TIMEOUT_MS, and each platform's whole sequence of calls gets PROVIDER_BUDGET_MS;
# a platform that overruns is skipped, falling back to its last good items if there are any.
# PROVIDER_TIMEOUT_MS=8000
# PROVIDER_BUDGET_MS=20000

# ---- Platform allow-list --------------------------------------------------------
# Comma-separated ids to show, or "all" (default):
# tiktok,instagram,youtube,twitter,facebook,threads,reddit,pinterest,twitch,snapchat,bluesky
# ENABLED_PROVIDERS=all

# ---- Platform credentials --------------------------------------------------------
# Leave any platform blank and it runs in demo mode with a generated catalogue.
# Register redirect URI: {APP_BASE_URL}/api/connect/<provider>/callback

# TikTok (Login Kit + Display API; scopes user.info.basic, video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram (Instagram API with Instagram Login; scope instagram_business_basic)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# YouTube (Google OAuth; scope youtube.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter (OAuth 2.0 PKCE; scopes tweet.read users.read offline.access)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Facebook (Facebook Login + Graph API; scopes public_profile, user_videos)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Threads (Threads API; scope threads_basic)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Reddit (OAuth2 "web app"; scopes identity, read)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pinterest (API v5; scopes pins:read, user_accounts:read)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Twitch (Helix; scope user:read:follows)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Snapchat has no third-party content API for Spotlight; it is demo-only and needs no keys.
# Bluesky needs no keys either: users connect with an app password from the Connections page.
